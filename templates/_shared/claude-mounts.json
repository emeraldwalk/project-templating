// Isolated Claude settings per worktree
    "source=claude-code-config-${localWorkspaceFolderBasename},target=/home/vscode/.claude,type=volume",

    // Isolated Claude settings per project (not sure which is better here)
    // "source=claude-code-config-{{ .GIT_WORKTREE_MAIN_FOLDER_BASENAME }},target=/home/vscode/.claude,type=volume",

    // Bind-mount user level .claude things
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude/CLAUDE.md,target=/home/vscode/.claude/CLAUDE.md,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude/settings.json,target=/home/vscode/.claude/settings.json,type=bind,consistency=cached",

